# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. All data (schedules, history, and pill photos)
# persists here — no volume or external storage needed.
# On Railway: add a PostgreSQL database and reference its variable, e.g.
#   DATABASE_URL="${{Postgres.DATABASE_URL}}"
# Locally: point at any Postgres, e.g.
#   DATABASE_URL="postgresql://user:pass@localhost:5432/pilltracker"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pilltracker"

# Secret used to sign login session tokens. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Anthropic API key — powers pill identification and photo confirmation.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# The Claude vision model used for pill analysis.
ANTHROPIC_MODEL="claude-sonnet-5"

# Web Push (VAPID) keys for browser notifications / alerts.
# Generate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret to protect the reminder cron endpoint (/api/cron/reminders).
CRON_SECRET="change-me-too"
