# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# SQLite database file (data persists indefinitely on the host).
# For production, swap for a managed Postgres URL and update prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Secret used to sign login session tokens. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Anthropic API key — powers pill identification and photo confirmation.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# The Claude vision model used for pill analysis.
ANTHROPIC_MODEL="claude-sonnet-5"

# Web Push (VAPID) keys for browser notifications / alerts.
# Generate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret to protect the reminder cron endpoint (/api/cron/reminders).
CRON_SECRET="change-me-too"
